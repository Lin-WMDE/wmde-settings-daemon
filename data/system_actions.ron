{
    /// Decreases screen brightness
    BrightnessDown: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon DecreaseDisplayBrightness",
    /// Increases screen brightness
    BrightnessUp: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon IncreaseDisplayBrightness",
    /// Toggles display mode
    DisplayToggle: "wmde-osd display",
    /// Switch between input sources
    InputSourceSwitch: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon InputSourceSwitch",
    /// Opens the home folder in a system default file browser
    HomeFolder: "xdg-open ~",
    /// Opens the system default terminal
    Terminal: "wmde-term",
    /// Logs out
    LogOut: "wmde-osd log-out",
    /// Decreases keyboard brightness
    // KeyboardBrightnessDown,
    /// Increases keyboard brightness
    // KeyboardBrightnessUp,
    /// Opens the Start menu: the Start menu applet answers on the session bus
    Launcher: "busctl --user call fun.wmde.StartMenu /fun/wmde/StartMenu fun.wmde.StartMenu TogglePopupSignal",
    /// Locks the screen
    LockScreen: "loginctl lock-session",
    /// Mutes the active output device
    Mute: "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    /// Mutes the active microphone
    MuteMic: "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    /// Plays and Pauses audio
    PlayPause: "playerctl play-pause",
    /// Goes to the next track
    PlayNext: "playerctl next",
    /// Goes to the previous track
    PlayPrev: "playerctl previous",
    /// Power off handler
    PowerOff: "wmde-osd shutdown",
    /// Suspend the system
    Suspend: "systemctl suspend",
    /// Toggles the screen reader
    ScreenReader: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon ScreenReader",
    /// Toggles touchpad on/off
    TouchpadToggle: "wmde-osd touchpad",
    /// Lowers the volume of the active output device
    VolumeLower: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon VolumeDown",
    /// Raises the volume of the active output device
    VolumeRaise: "busctl --user call fun.wmde.SettingsDaemon /fun/wmde/SettingsDaemon fun.wmde.SettingsDaemon VolumeUp",
    /// Opens the system default web browser
    WebBrowser: "xdg-open http://",
}
